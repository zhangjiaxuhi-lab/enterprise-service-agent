# ============================================================
# 企业级智能客服与工单协同中枢 - 环境变量配置模板
# 使用方式：复制本文件为 .env 并填入真实值
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================================

# ---------- 阿里云百炼 DashScope（通义千问） ----------
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_key_here

# DashScope OpenAI 兼容模式接入点（一般无需修改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 模型配置 ----------
# 主力推理模型
MODEL_NAME=qwen-plus
# 温度：客服场景建议低温度，保证答复稳定
MODEL_TEMPERATURE=0.1
# 单次请求超时（秒）
MODEL_TIMEOUT=60

# ---------- 应用配置 ----------
APP_NAME=enterprise-service-agent
APP_ENV=development
LOG_LEVEL=INFO

# ---------- 智能体运行模式 ----------
# 置为 1/true/yes 时使用离线确定性 mock 模型（不调用 DashScope），
# 便于无 API Key 环境下验证状态机结构、路由与槽位填充规则。
# 生产环境请保持注释状态或设为 0。
# CUSTOMER_AGENT_MOCK=0

# ---------- 知识库配置 ----------
# 知识库文档目录（相对于项目根目录）
KNOWLEDGE_BASE_DIR=data/docs

# ---------- 会话检查点（持久化） ----------
# 后端选择：sqlite（默认，落盘，支持多进程共享）或 memory（仅测试/演示）
#   * sqlite：会话状态写入 CHECKPOINT_DB_PATH，进程重启后仍可恢复，
#             多 worker 部署时共享同一份状态（WAL 模式）。
#   * memory：纯内存，重启即丢；仅建议用于测试或一次性演示。
# sqlite 初始化失败时会自动降级为 memory，降级原因通过 GET /health 暴露。
CHECKPOINT_BACKEND=sqlite

# SQLite 数据库路径（相对路径基于项目根目录；已加入 .gitignore）
CHECKPOINT_DB_PATH=data/runtime/checkpoints.db

# ---------- API 服务配置 ----------
API_HOST=127.0.0.1
API_PORT=8000
